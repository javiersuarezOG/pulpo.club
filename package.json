{
  "name": "pulpo-club",
  "version": "0.1.0",
  "private": true,
  "description": "Salvadoran beach + raw-land aggregator — Vercel serverless auth + static dashboard.",
  "type": "module",
  "scripts": {
    "stripe:setup": "node automation/stripe_setup.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/build_sitemap.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint:css": "stylelint 'web/app/**/*.css'",
    "check:contrast": "node web/app/styles/check-contrast.mjs",
    "check:size": "node web/app/styles/check-bundle-size.mjs",
    "e2e:critical": "playwright test --project=chromium --grep \"@critical\"",
    "e2e:responsive": "playwright test --project=chromium tests/e2e/responsive-smoke.spec.ts",
    "e2e:legacy": "playwright test --project=chromium --grep \"@legacy\"",
    "e2e:smoke": "playwright test --project=chromium",
    "e2e:authed": "playwright test --project=authed tests/e2e/account-authed.spec.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.6",
    "@clerk/localizations": "^4.6.6",
    "@clerk/react": "^6.6.1",
    "@vercel/blob": "^2.4.0",
    "@vercel/og": "^0.11.1",
    "posthog-js": "^1.372.9",
    "posthog-node": "^5.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.12.3",
    "sharp": "^0.33.5",
    "stripe": "^22.1.1",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@clerk/testing": "^1.14.8",
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
