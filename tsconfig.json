{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    // Pinned empty so adding @types/node for the server project
    // (tsconfig.api.json) cannot leak Node globals into the browser
    // build. Package-scoped types (react, leaflet) still resolve
    // through normal module resolution and are unaffected.
    "types": []
  },
  "include": ["web/app/**/*", "web/index.html", "shared/**/*"],
  "exclude": ["node_modules", "new_ux", "web/assets", "automation", "pulpo"]
}
